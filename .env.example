DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dmo
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/dmo
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
POOL_SIZE=10
MAX_OVERFLOW=5
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
API_KEY=your-secret-key
